# Opsætning til BigWigs-packageren (bruges af .github/workflows/release.yml).
# Addonet ligger i undermappen WastedCoast/, så den flyttes op og bliver selve zip-indholdet.
package-as: WastedCoast

# Release-noter laves af .github/scripts/changelog.sh i workflowet: kun den nye versions
# ændringer og uden Co-Authored-By/Claude-Session-linjer.
manual-changelog:
  filename: CHANGELOG-release.md
  markup-type: markdown

move-folders:
  WastedCoast/WastedCoast: WastedCoast

ignore:
  - tests
  - docs
  - README.md
  - install.bat
  - .gitignore
  - CHANGELOG-release.md
  - .github
